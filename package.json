{
  "name": "aria-player",
  "productName": "Aria",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Aria —— iOS 设计风格的本地音乐播放器（Electron）",
  "main": "src/main/main.js",
  "author": "Aria",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "check": "node scripts/check-imports.js && node scripts/check-injected.js && node scripts/check-styles.js && node --check src/main/main.js",
    "check:styles": "node scripts/check-styles.js",
    "shots": "electron . --shots",
    "audit": "electron . --audit",
    "perf": "electron . --perf",
    "probe": "node scripts/probe-library.js"
  },
  "dependencies": {
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "electron": "^42.0.0"
  }
}
