{
  "name": "aria-player",
  "productName": "Aria",
  "version": "0.1.0-beta.47",
  "private": true,
  "description": "Aria —— iOS 设计风格的本地音乐播放器（Electron）",
  "main": "src/main/main.js",
  "author": "Aria",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "check": "node scripts/checks/check-imports.js && node scripts/checks/check-injected.js && node scripts/checks/check-styles.js && node scripts/checks/check-contrast.js && node scripts/checks/check-frosted.js && node scripts/checks/check-shots.js && node scripts/checks/check-architecture.js && node scripts/checks/check-mac-source-zip.js && node scripts/checks/check-docs.js && node scripts/checks/check-menu-roles.js && node scripts/checks/check-mac-config.js && node --check src/main/main.js",
    "check:styles": "node scripts/checks/check-styles.js",
    "check:contrast": "node scripts/checks/check-contrast.js",
    "check:shots": "node scripts/checks/check-shots.js",
    "check:mac-zip": "node scripts/checks/check-mac-source-zip.js",
    "shots": "electron . --shots",
    "audit": "electron . --audit",
    "perf": "electron . --perf",
    "probe": "node scripts/probes/probe-library.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "check:arch": "node scripts/checks/check-architecture.js",
    "make:mac-zip": "node scripts/make-mac-source-zip.js",
    "check:mac-config": "node scripts/checks/check-mac-config.js",
    "check:frosted": "node scripts/checks/check-frosted.js"
  },
  "dependencies": {
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.aria.player",
    "productName": "Aria",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.md",
      "!docs/**",
      "!scripts/**",
      "!release/**",
      "!tests/**",
      "!src/main/smoke.js",
      "!src/main/screenshot.js",
      "!src/main/perf.js",
      "!src/main/visual-audit.js"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/mac-adhoc-sign.js",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Aria-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Aria"
    },
    "portable": {
      "artifactName": "Aria-${version}-portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Aria-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Aria ${version}",
      "iconSize": 128,
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
