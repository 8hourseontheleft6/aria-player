{
  "name": "aria-player",
  "productName": "Aria",
  "version": "0.1.0-beta.49",
  "private": true,
  "description": "Aria —— iOS 设计风格的本地音乐播放器（Electron）",
  "main": "src/main/main.js",
  "author": "Aria",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "check": "node scripts/checks/check-imports.js && node scripts/checks/check-injected.js && node scripts/checks/check-profiles.js && node scripts/checks/check-styles.js && node scripts/checks/check-contrast.js && node scripts/checks/check-frosted.js && node scripts/checks/check-shots.js && node scripts/checks/check-architecture.js && node scripts/checks/check-mac-source-zip.js && node scripts/checks/check-docs.js && node scripts/checks/check-menu-roles.js && node scripts/checks/check-mac-config.js && node --check src/main/main.js",
    "check:styles": "node scripts/checks/check-styles.js",
    "check:contrast": "node scripts/checks/check-contrast.js",
    "check:shots": "node scripts/checks/check-shots.js",
    "check:mac-zip": "node scripts/checks/check-mac-source-zip.js",
    "shots": "electron . --shots",
    "audit": "electron . --audit",
    "perf": "electron . --perf",
    "probe": "node scripts/probes/probe-library.js",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "check:arch": "node scripts/checks/check-architecture.js",
    "make:mac-zip": "node scripts/make-mac-source-zip.js",
    "check:mac-config": "node scripts/checks/check-mac-config.js",
    "check:frosted": "node scripts/checks/check-frosted.js",
    "check:profiles": "node scripts/checks/check-profiles.js",
    "dist:player": "electron-builder --config electron-builder.player.yml --win --x64",
    "dist:player:portable": "electron-builder --config electron-builder.player.yml --win portable --x64",
    "dist:player:mac": "electron-builder --config electron-builder.player.yml --mac --publish never",
    "dist:unified": "electron-builder --config electron-builder.unified.yml --win --x64",
    "dist:unified:portable": "electron-builder --config electron-builder.unified.yml --win portable --x64",
    "dist:unified:mac": "electron-builder --config electron-builder.unified.yml --mac --publish never"
  },
  "dependencies": {
    "music-metadata": "^11.9.0"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "^26.15.3"
  }
}
