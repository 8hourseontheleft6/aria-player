{
  "name": "aria-player",
  "productName": "Aria",
  "version": "0.2.0-beta.3",
  "private": true,
  "description": "Aria —— iOS 设计风格的本地音乐播放器（Electron）",
  "main": "src/main/main.js",
  "author": "deepseek",
  "contributors": [
    "8左边的白马6"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test:backend": "node scripts/checks/check-backend.js",
    "test:backend:electron": "electron scripts/checks/check-backend-electron.js",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "check": "node scripts/checks/check-imports.js && node scripts/checks/check-injected.js && node scripts/checks/check-profiles.js && node scripts/checks/check-styles.js && node scripts/checks/check-contrast.js && node scripts/checks/check-frosted.js && node scripts/checks/check-shots.js && node scripts/checks/check-architecture.js && node scripts/checks/check-mac-source-zip.js && node scripts/checks/check-docs.js && node scripts/checks/check-menu-roles.js && node scripts/checks/check-mac-config.js && node --check src/main/main.js && node scripts/checks/check-ai-subtitles.js && node scripts/checks/check-replaygain.js && node scripts/checks/check-diagnostics.js && node scripts/checks/check-updater.js && node scripts/checks/check-resume.js && node scripts/checks/check-settings-transfer.js && node scripts/checks/check-duplicates.js",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:styles": "node scripts/checks/check-styles.js",
    "check:contrast": "node scripts/checks/check-contrast.js",
    "check:shots": "node scripts/checks/check-shots.js",
    "check:mac-zip": "node scripts/checks/check-mac-source-zip.js",
    "shots": "electron . --shots",
    "audit": "electron . --audit",
    "perf": "electron . --perf",
    "probe": "node scripts/probes/probe-library.js",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "check:arch": "node scripts/checks/check-architecture.js",
    "make:mac-zip": "node scripts/make-mac-source-zip.js",
    "check:mac-config": "node scripts/checks/check-mac-config.js",
    "check:frosted": "node scripts/checks/check-frosted.js",
    "check:profiles": "node scripts/checks/check-profiles.js",
    "dist:player": "electron-builder --config electron-builder.player.yml --win --x64 --publish never",
    "dist:player:portable": "electron-builder --config electron-builder.player.yml --win portable --x64",
    "dist:player:mac": "electron-builder --config electron-builder.player.yml --mac --publish never",
    "dist:unified": "electron-builder --config electron-builder.unified.yml --win --x64 --publish never",
    "dist:unified:portable": "electron-builder --config electron-builder.unified.yml --win portable --x64",
    "dist:unified:mac": "electron-builder --config electron-builder.unified.yml --mac --publish never",
    "artifacts": "node scripts/artifacts.mjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "fetch-release": "node scripts/fetch-release.mjs",
    "perf:baseline": "electron . --perf-baseline"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "electron-updater": "^6.8.11",
    "music-metadata": "^11.9.0",
    "quickjs-emscripten": "0.32.0",
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/8hourseontheleft6/aria-player.git"
  },
  "homepage": "https://github.com/8hourseontheleft6/aria-player#readme",
  "bugs": {
    "url": "https://github.com/8hourseontheleft6/aria-player/issues"
  },
  "keywords": [
    "electron",
    "music-player",
    "ios-design",
    "local-music"
  ]
}
