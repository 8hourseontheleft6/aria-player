node_modules/
dist/
out/
*.log
.DS_Store
Thumbs.db

*.err

# 临时脚本与提交信息文件（我是用 `Out-File tmp-msg.txt` 写提交信息，
# 有一次 `git add -A` 把它一起提交了 —— 这类文件名一律不进仓库）
tmp-*
.tmp-*

# 用户提供的均衡器参考数据（体积小，按需入库为 docs/equalizer-data.json）

# 自检夹具（scripts/make-fixtures.mjs 或自检脚本运行时生成，几十 MB 二进制不进仓库）
tests/

# 用户数据（settings.json / recent.json / 缓存之类，永不入库）
*.settings.json

# 打包产物（npm run dist）
release/
.tmp/

# Aria Player build output (second product, npm run dist:player)
release-player/

# Aria Unified build output (third product, npm run dist:unified)
release-unified/
